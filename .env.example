# Local self-hosted provider. Redis Agent Memory V0 is development-only.
MEMORY_PROVIDER=redis-agent-memory
AGENT_MEMORY_URL=http://agent-memory-api:8000
AGENT_MEMORY_API_KEY=

# Bind for `npm start` / CLI serve. Keep loopback. docker-compose.memory.yml
# overrides this to 0.0.0.0 inside the container and publishes 127.0.0.1 on the host.
MEMORY_MCP_HOST=127.0.0.1
MEMORY_MCP_PORT=8787
MEMORY_DISABLE_AUTH=false
MEMORY_WORKSPACE_ID=local

# JSON map of agent identity to a unique random key (minimum 24 characters).
# Store real values in a secret manager or an untracked .env, never in Git.
# The strings below are rejected at startup. Run ./scripts/setup-memory.sh instead.
MEMORY_AGENT_KEYS_JSON={"codex":"replace-with-random-key-at-least-24-chars","grok":"replace-with-another-random-key-24-chars","composer":"replace-with-another-random-key-24-chars","orca":"replace-with-another-random-key-24-chars"}
# Each authenticated agent gets explicit workspace/project authorization.
# Keep grants on one workspace. Never ship workspaceId "*" unless every agent
# is trusted with every workspace. projectIds "*" shares all projects in that workspace.
MEMORY_AGENT_GRANTS_JSON={"codex":[{"workspaceId":"local","projectIds":["*"]}],"grok":[{"workspaceId":"local","projectIds":["*"]}],"composer":[{"workspaceId":"local","projectIds":["*"]}],"orca":[{"workspaceId":"local","projectIds":["*"],"allowGlobal":true}]}

MEMORY_WORKING_TTL_SECONDS=21600
MEMORY_MAX_RESULTS=7
MEMORY_MIN_RELEVANCE=0.25
MEMORY_MAX_CONTEXT_TOKENS=2000
MEMORY_MAX_CONTENT_BYTES=16384
MEMORY_REQUEST_TIMEOUT_MS=3000
MEMORY_MAX_RETRIES=2
MEMORY_RATE_LIMIT_PER_MINUTE=120

# Local generation and embeddings used by Redis Agent Memory Server V0.
OLLAMA_API_BASE=http://host.docker.internal:11434
GENERATION_MODEL=ollama/qwen3:8b
FAST_MODEL=ollama/qwen3:8b
SLOW_MODEL=ollama/qwen3:8b
EMBEDDING_MODEL=ollama/nomic-embed-text
REDISVL_VECTOR_DIMENSIONS=768
REDISVL_INDEX_NAME=memory_records_ollama_768

# Optional fallback only. Not required when the models above use Ollama.
OPENAI_API_KEY=

# V0 auth is disabled only inside the private Compose network. The API is not published.
AGENT_MEMORY_DISABLE_AUTH=true
